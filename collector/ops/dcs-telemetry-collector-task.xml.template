<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Boot fallback for the persistent DCS telemetry collector; not a periodic launcher.</Description>
  </RegistrationInfo>
  <Triggers>
    <BootTrigger><Enabled>true</Enabled><Delay>PT30S</Delay></BootTrigger>
  </Triggers>
  <Principals>
    <Principal id="CollectorIdentity">
      <UserId>{{SERVICE_IDENTITY}}</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RestartOnFailure><Interval>PT1M</Interval><Count>3</Count></RestartOnFailure>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="CollectorIdentity">
    <Exec>
      <Command>{{NODE_EXE}}</Command>
      <Arguments>--env-file=&quot;{{SERVICE_SETTINGS_FILE}}&quot; &quot;{{COLLECTOR_SERVICE_JS}}&quot; --input &quot;{{INPUT_DIR}}&quot; --state &quot;{{STATE_DIR}}&quot; --schema &quot;{{SCHEMA_FILE}}&quot; --url &quot;https://dcs-missions.vercel.app&quot; --interval-ms 5000 --max-cycle-bytes 2097152 --lock-port {{LOCK_PORT}}</Arguments>
      <WorkingDirectory>{{COLLECTOR_DIR}}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
